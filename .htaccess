# Declare UTF-8 for browsers, link previews and search crawlers.
AddDefaultCharset UTF-8
<IfModule mod_mime.c>
AddCharset UTF-8 .html .htm .css .js .mjs .json .xml .txt .svg
</IfModule>

AddType text/javascript .mjs

<IfModule mod_rewrite.c>
RewriteEngine On
# Redirect only explicit browser requests, never internal HTML resolution.
RewriteCond %{THE_REQUEST} \s/+index(?:\.html)?(?:[?\s]) [NC]
RewriteRule ^index(?:\.html)?$ / [R=301,L]
RewriteCond %{THE_REQUEST} \s/+portfolio(?:\.html)?(?:[?\s]) [NC]
RewriteRule ^portfolio(?:\.html)?$ /profiles [R=301,L]
RewriteCond %{THE_REQUEST} \s/+[a-z0-9-]+\.html(?:[?\s]) [NC]
RewriteRule ^(about|account|cafe|contacts|creative-formats|jasmine|kids|logos|maps-before-ads|maps|privacy|profile-content|services|terms|useful|visual|website-before-ads|websites)\.html$ /$1 [R=301,L]
RewriteRule ^(about|account|cafe|contacts|creative-formats|jasmine|kids|logos|maps-before-ads|maps|privacy|profile-content|services|terms|useful|visual|website-before-ads|websites|profiles)/$ /$1 [R=301,L]
# Keep assets and cabinet API paths untouched.
RewriteRule ^profiles$ portfolio.html [END]
RewriteRule ^(about|account|cafe|contacts|creative-formats|jasmine|kids|logos|maps-before-ads|maps|privacy|profile-content|services|terms|useful|visual|website-before-ads|websites)$ $1.html [END]
</IfModule>
