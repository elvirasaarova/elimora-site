AddType text/javascript .mjs

# Keep the public homepage URL clean; internal DirectoryIndex requests must not redirect.
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTP_HOST} ^(?:www\.)?elimora\.ru(?::[0-9]+)?$ [NC]
RewriteCond %{THE_REQUEST} \s/+index\.html(?:[?\s]) [NC]
RewriteRule ^index\.html$ / [R=301,L]
</IfModule>
